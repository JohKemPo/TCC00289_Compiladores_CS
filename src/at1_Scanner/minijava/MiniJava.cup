package at1_Scanner.minijava;

import java_cup.runtime.*;

// Terminals
terminal CLASS_DECL, PUBLIC, STATIC, VOID, MAIN, STRING;
terminal LBRACE, RBRACE, LPAREN, RPAREN, LBRACK, RBRACK;
terminal String IDENTIFIER;

// Non-terminals  
non terminal String program;
non terminal String mainClass;

start with program;

// Program ::= MainClass
program ::= mainClass:mc
    {: 
        System.out.println("=== Programa MiniJava aceito ===");
        RESULT = "Programa: " + mc;
    :}
;

// MainClass ::= "class" Identifier "{" "public" "static" "void" "main" "(" "String" "[" "]" Identifier ")" "{" "}" "}"
mainClass ::= CLASS_DECL IDENTIFIER:className LBRACE 
              PUBLIC STATIC VOID MAIN LPAREN STRING LBRACK RBRACK IDENTIFIER:argName RPAREN 
              LBRACE RBRACE 
              RBRACE
    {: 
        RESULT = "MainClass[" + className + "]"; 
    :}
;